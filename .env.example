# PROJECT CONFIGURATION

PROJECT_NAME=dota2-data-engineering
ENVIRONMENT=development
LOG_LEVEL=INFO

# POSTGRESQL

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dota2
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Optional: connection URL
POSTGRES_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/dota2

# MONGODB

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=dota2
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password

# Optional: connection URL
MONGO_URI=mongodb://your_mongo_user:your_mongo_password@localhost:27017/dota2

# MINIO (S3-COMPATIBLE STORAGE)

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=dota2-data
MINIO_SECURE=false

# TRINO

TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=your_trino_user
TRINO_CATALOG=iceberg
TRINO_SCHEMA=default

# APACHE SPARK

SPARK_MASTER=local[*]
SPARK_APP_NAME=dota2-data-pipeline

# APACHE AIRFLOW

AIRFLOW_HOST=localhost
AIRFLOW_PORT=8080
AIRFLOW_USERNAME=your_airflow_username
AIRFLOW_PASSWORD=your_airflow_password

# DATA LAKE / ICEBERG

ICEBERG_CATALOG=lakehouse
ICEBERG_DATABASE=stage

# DATA PROCESSING

BATCH_SIZE=1000
MAX_RETRIES=3
